POSTGRES_USER=dataforge
POSTGRES_PASSWORD=dataforge_dev_password
POSTGRES_DB=dataforge
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# --- Airflow (Faza 3, profil "airflow" — pornit doar cu `make airflow-up`) ---

# Postgres separat pentru metadata Airflow (DAG runs, task instances, logs) —
# izolat intentionat de POSTGRES_* de mai sus, care e DWH-ul orchestrat.
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow_dev_password
AIRFLOW_POSTGRES_DB=airflow

# Cheie de criptare pentru Connections/Variables in metadata DB — trebuie sa fie
# aceeasi in webserver si scheduler ca sa poata decripta reciproc ce scrie celalalt.
# Poti lasa gol pt local/portofoliu (Airflow doar dezactiveaza criptarea, cu warning
# — nu stocam parole in Connections aici, doar in .env). Ca sa o generezi:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Orice string lung/aleator — protejeaza sesiunile webserver-ului.
AIRFLOW_WEBSERVER_SECRET_KEY=change_me_to_a_random_string

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Webhook-ul unui canal Discord (Server Settings -> Integrations -> Webhooks).
# Necompletat = pipeline-ul tot ruleaza, doar nu trimite alerta la esec.
DISCORD_WEBHOOK_URL=

# --- GitHub (Faza 5, sursa v2) ---

# Personal Access Token (fine-grained, read-only pe Contents/Metadata/Pull requests
# ale conturilor tale) — github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
# Contul ale carui repo-uri se ingesteaza (type=owner, deci doar cele proprii, nu forks din alte conturi).
GITHUB_USERNAME=
# Optional, format YYYY-MM-DD: limiteaza cat de mult istoric de commit-uri se trage.
# Necompletat = se parcurge tot istoricul fiecarui repo la fiecare rulare (dedup-ul
# se face oricum in raw pe cheia naturala sha+repo, deci nu apar duplicate).
GITHUB_COMMITS_SINCE=
